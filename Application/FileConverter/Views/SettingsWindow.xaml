<Window
    x:Class="FileConverter.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:FileConverter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:generic="clr-namespace:FileConverter.ValueConverters.Generic"
    xmlns:local="clr-namespace:FileConverter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:project="clr-namespace:FileConverter.Properties"
    xmlns:viewModels="clr-namespace:FileConverter.ViewModels"
    xmlns:views="clr-namespace:FileConverter.Views"
    Width="1050"
    Height="700"
    MinWidth="800"
    MinHeight="600"
    DataContext="{Binding Settings, Source={StaticResource Locator}}"
    Icon="/FileConverter;component/Resources/ApplicationIcon.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closing">
            <behaviors:InvokeCommandAction Command="{Binding CloseCommand}" PassEventArgsToCommand="True" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ConversionPresetTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <generic:IcoFileSizeSelectorConverter x:Key="IcoFileSizeSelector" />
            <generic:EqualsConverter x:Key="EqualsConverter" />

            <DataTemplate x:Key="NoPresetSelectedTemplate" DataType="{x:Type viewModels:SettingsViewModel}">
                <Label
                    Height="auto"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{x:Static project:Resources.NoPresetSelected}"
                    FontSize="20" />
            </DataTemplate>

            <DataTemplate x:Key="FolderSelectedTemplate" DataType="{x:Type viewModels:SettingsViewModel}">
                <GroupBox Header="{x:Static project:Resources.PresetFolder}">
                    <Grid Margin="5" DataContext="{Binding SelectedFolder}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="*" MaxWidth="240" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Grid.Column="0">
                            <Label
                                Margin="0,0,5,0"
                                HorizontalContentAlignment="Right"
                                Content="{x:Static project:Resources.PresetFolderName}" />
                            <TextBox
                                Width="Auto"
                                Margin="5,2,25,2"
                                FontSize="15"
                                Loaded="SelectedFolderName_OnLoaded"
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </Grid>
                </GroupBox>
            </DataTemplate>

            <DataTemplate x:Key="PresetSelectedTemplate" DataType="{x:Type viewModels:SettingsViewModel}">
                <GroupBox Header="{x:Static project:Resources.Preset}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="*" MaxWidth="240" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Grid.Column="0">
                            <Label Margin="0,0,5,0" Content="{x:Static project:Resources.PresetName}" />
                            <TextBox
                                Margin="5,2,5,2"
                                FontSize="15"
                                Loaded="SelectedPresetName_OnLoaded"
                                Text="{Binding SelectedPreset.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                TextWrapping="Wrap" />
                        </DockPanel>

                        <GroupBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            Header="{x:Static project:Resources.OutputFormat}">
                            <StackPanel>
                                <ComboBox
                                    Height="29"
                                    Margin="5"
                                    VerticalAlignment="Top"
                                    ItemsSource="{Binding OutputTypes}"
                                    SelectedItem="{Binding SelectedPreset.Preset.OutputType, Converter={StaticResource OutputTypeEnumToViewModel}, Mode=TwoWay}">
                                    <ComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Padding="5,5,5,5"
                                                        Background="{DynamicResource MainLighterBrush}"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource MainDarkBrush}"
                                                        Text="{Binding Name, Converter={StaticResource ObjectToLocalizedString}}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ComboBox.GroupStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:OutputTypeViewModel}">
                                            <TextBlock Padding="10,2,2,2" Text="{Binding Type}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ContentControl Content="{Binding SelectedPreset.Preset}" Style="{StaticResource ConversionSettingsSelectorStyle}" />

                                <Separator />

                                <!--  Output file name template  -->
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="23" />
                                        <RowDefinition Height="23" />
                                        <RowDefinition Height="23" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Margin="0,0,5,0"
                                        HorizontalContentAlignment="Right"
                                        Content="{x:Static project:Resources.FileNameTemplate}" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="Auto"
                                        Margin="5,2,25,2"
                                        Text="{Binding SelectedPreset.OutputFileNameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        TextWrapping="Wrap"
                                        ToolTip="{x:Static project:Resources.OutputFilePathTemplateHelp}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,5,0"
                                        HorizontalContentAlignment="Right"
                                        Content="{x:Static project:Resources.InputExample}"
                                        FontSize="10"
                                        Foreground="{DynamicResource LighterForegroundBrush}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{DynamicResource LighterForegroundBrush}"
                                        Text="{x:Static project:Resources.OutputFileNameTemplateSample}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,5,0"
                                        HorizontalContentAlignment="Right"
                                        Content="{x:Static project:Resources.OutputExample}"
                                        FontSize="10"
                                        Foreground="{DynamicResource LighterForegroundBrush}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{DynamicResource LighterForegroundBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource FileNameConverter}">
                                                <Binding Source="{x:Static project:Resources.OutputFileNameTemplateSample}" />
                                                <Binding Mode="OneWay" Path="SelectedPreset.Preset.OutputType" />
                                                <Binding Mode="OneWay" Path="SelectedPreset.Preset.OutputFileNameTemplate" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="5,0,5,0">
                                        <Hyperlink Command="{Binding OpenUrlCommand, Mode=OneWay}" CommandParameter="https://github.com/Tichau/FileConverter/wiki/Output-file-path-template">
                                            <Run Text="{x:Static project:Resources.Help}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>

                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Header="{x:Static project:Resources.InputFormats}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>

                                <TreeView x:Name="InputTypesTreeView" ItemsSource="{Binding InputCategories}">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type viewModels:InputExtensionCategory}" ItemsSource="{Binding InputExtensions}">
                                            <CheckBox
                                                Height="20"
                                                Margin="2"
                                                VerticalAlignment="Top"
                                                Content="{Binding Name, Converter={StaticResource ObjectToLocalizedString}}"
                                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                IsThreeState="True" />
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:InputExtension}">
                                            <CheckBox
                                                Height="20"
                                                Margin="2"
                                                VerticalAlignment="Top"
                                                Content="{Binding Name}"
                                                Foreground="{Binding ForegroundBrush}"
                                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                ToolTip="{Binding ToolTip}" />
                                        </DataTemplate>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="True" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>

                                <Label
                                    Grid.Row="1"
                                    Content="{x:Static project:Resources.ActionWhenConversionSucceedTitle}"
                                    ToolTip="{x:Static project:Resources.ActionWhenConversionSucceedDescription}" />
                                <ComboBox
                                    Grid.Row="2"
                                    ItemsSource="{Binding InputPostConversionActions, Mode=OneTime}"
                                    SelectedItem="{Binding SelectedPreset.Preset.InputPostConversionAction, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Converter={StaticResource ObjectToLocalizedString}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Margin="0,5,0,0">
                                    <Hyperlink Command="{Binding OpenUrlCommand, Mode=OneWay}" CommandParameter="https://github.com/Tichau/FileConverter/wiki/Input-file-post-conversion-actions">
                                        <Run Text="{x:Static project:Resources.Help}" />
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </GroupBox>
            </DataTemplate>

            <Style x:Key="SettingsSelectorStyle" TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate" Value="{StaticResource NoPresetSelectedTemplate}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedFolder, Converter={StaticResource EqualsConverter}}" Value="False">
                        <Setter Property="ContentTemplate" Value="{StaticResource FolderSelectedTemplate}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedPreset, Converter={StaticResource EqualsConverter}}" Value="False">
                        <Setter Property="ContentTemplate" Value="{StaticResource PresetSelectedTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Title>
        <Binding
            Converter="{StaticResource ApplicationVersionToApplicationName}"
            Mode="OneWay"
            Path="(local:Application.ApplicationVersion)" />
    </Window.Title>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="53" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Width="48"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="{Binding Source=/FileConverter;component/Resources/SettingsIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=96}" />

            <Label
                Grid.Column="1"
                Margin="4"
                VerticalAlignment="Center"
                Content="{x:Static project:Resources.Settings}"
                FontSize="20" />
        </Grid>

        <TabControl Grid.Row="1">

            <!--  Conversion presets settings  -->
            <TabItem Height="28" Header="{x:Static project:Resources.ConversionPresets}">
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3.5*" />
                    </Grid.ColumnDefinitions>

                    <!--  Preset list  -->
                    <Grid x:Name="PresetListGrid" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>

                        <TreeView
                            Name="PresetTreeView"
                            Grid.Row="0"
                            Width="{Binding ActualWidth, ElementName=PresetListGrid, Mode=OneWay}"
                            views:DragDropExtension.ScrollOnDragDrop="True"
                            AllowDrop="True"
                            ItemsSource="{Binding PresetsRootFolder.Children}">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:PresetFolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Image
                                            Width="24"
                                            Height="24"
                                            Margin="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Source="{Binding Source=/FileConverter;component/Resources/FolderIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" />
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="DemiBold"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type viewModels:PresetNode}">
                                    <TextBlock
                                        Margin="5"
                                        FontSize="12"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError, FallbackValue=False}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Style.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource MainLighterColor}" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource MainDarkerColor}" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource DarkBackgroundColor}" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource LightForegroundColor}" />
                                    </Style.Resources>

                                    <Setter Property="IsExpanded" Value="True" />

                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeView_MouseDown" />
                                    <EventSetter Event="MouseUp" Handler="TreeView_MouseUp" />
                                    <EventSetter Event="DragOver" Handler="TreeView_DragOver" />
                                    <EventSetter Event="Drop" Handler="TreeView_Drop" />
                                    <EventSetter Event="MouseMove" Handler="TreeView_MouseMove" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <behaviors:Interaction.Behaviors>
                                <views:TreeViewSelectionBehavior
                                    ExpandSelected="False"
                                    HierarchyPredicate="{Binding PresetsHierarchyPredicate}"
                                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
                            </behaviors:Interaction.Behaviors>
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding CreateFolderCommand}" Header="{x:Static project:Resources.CreateANewFolder}">
                                        <MenuItem.Icon>
                                            <Image Source="{Binding Source=/FileConverter;component/Resources/FolderIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" Style="{StaticResource EnableDisableImageStyle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding AddNewPresetCommand}" Header="{x:Static project:Resources.AddNewPreset}">
                                        <MenuItem.Icon>
                                            <Image Source="{Binding Source=/FileConverter;component/Resources/PresetIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" Style="{StaticResource EnableDisableImageStyle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding DuplicatePresetCommand}" Header="{x:Static project:Resources.DuplicatePreset}">
                                        <MenuItem.Icon>
                                            <Image Source="{Binding Source=/FileConverter;component/Resources/DuplicatePresetIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" Style="{StaticResource EnableDisableImageStyle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Command="{Binding ImportPresetCommand}" Header="{x:Static project:Resources.ImportPresets}">
                                        <MenuItem.Icon>
                                            <Image Source="{Binding Source=/FileConverter;component/Resources/ImportIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" Style="{StaticResource EnableDisableImageStyle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding ExportPresetCommand}" Header="{x:Static project:Resources.ExportSelectedPresets}">
                                        <MenuItem.Icon>
                                            <Image Source="{Binding Source=/FileConverter;component/Resources/ExportIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" Style="{StaticResource EnableDisableImageStyle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Command="{Binding RemoveSelectedPresetCommand}" Header="{x:Static project:Resources.RemoveSelectedPreset}">
                                        <MenuItem.Icon>
                                            <Image Source="{Binding Source=/FileConverter;component/Resources/DeleteIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=48}" Style="{StaticResource EnableDisableImageStyle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding RemoveSelectedPresetCommand}" />
                            </TreeView.InputBindings>
                        </TreeView>

                        <TextBlock Grid.Row="1" Margin="4">
                            <Hyperlink Command="{Binding OpenUrlCommand, Mode=OneWay}" CommandParameter="https://github.com/Tichau/FileConverter/wiki/How-to-create-a-new-custom-preset%3F">
                                <Run Text="{x:Static project:Resources.Help}" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!--  Selected item settings  -->
                    <ContentControl
                        x:Name="SelectedItemSettings"
                        Grid.Column="1"
                        Margin="5,5,0,0"
                        Content="{Binding .}"
                        Style="{StaticResource SettingsSelectorStyle}" />
                </Grid>
            </TabItem>

            <!--  Application settings  -->
            <TabItem Header="{x:Static project:Resources.Application}">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.Language}" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,1"
                        ItemsSource="{Binding SupportedCultures, Mode=OneTime}"
                        SelectedValue="{Binding Settings.ApplicationLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Converter={StaticResource CultureInfoToString}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.MaximumNumberOfSimultaneousConversions}" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,0,5"
                        AutoToolTipPlacement="TopLeft"
                        Maximum="16"
                        Minimum="1"
                        SmallChange="1"
                        TickPlacement="BottomRight"
                        Value="{Binding Settings.MaximumNumberOfSimultaneousConversions, Mode=TwoWay}" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.AutomaticallyExitWhenAllConversionsFinished}" />
                    <CheckBox
                        x:Name="QuitAtEndCheckBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,5,0,5"
                        IsChecked="{Binding Settings.ExitApplicationWhenConversionsFinished, Mode=TwoWay}" />

                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.ExitWaitingDuration}"
                        Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed, ElementName=QuitAtEndCheckBox}" />
                    <DockPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,5,0,5"
                        Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed, ElementName=QuitAtEndCheckBox}">
                        <Slider
                            x:Name="DurationBeforeQuitSlider"
                            Width="250"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="0"
                            SmallChange="0.1"
                            TickFrequency="0.1"
                            Value="{Binding Settings.DurationBetweenEndOfConversionsAndApplicationExit, Mode=TwoWay}" />
                        <Label Content="{Binding Value, Converter={StaticResource DoubleToTimeString}, ElementName=DurationBeforeQuitSlider}" />
                    </DockPanel>

                    <Label
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.AutomaticallyCheckForUpdates}" />
                    <CheckBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,5,0,5"
                        IsChecked="{Binding Settings.CheckUpgradeAtStartup, Mode=TwoWay}" />

                    <Label
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.CopyFilesInClipboardAfterConversion}" />
                    <CheckBox
                        x:Name="CopyFilesInClipboardAfterConversionCheckBox"
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,5,0,5"
                        IsChecked="{Binding Settings.CopyFilesInClipboardAfterConversion, Mode=TwoWay}" />

                    <Label
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Content="{x:Static project:Resources.HardwareAccelerationMode}" />
                    <ComboBox
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="0,0,0,1"
                        ItemsSource="{Binding HardwareAccelerationModes, Mode=OneTime}"
                        SelectedValue="{Binding Settings.HardwareAccelerationMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Converter={StaticResource HardwareAccelerationModeToString}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </TabItem>

            <!--  About  -->
            <TabItem Header="{x:Static project:Resources.About}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="256" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <Label FontSize="28">
                            <Label.Content>
                                <Binding
                                    Converter="{StaticResource ApplicationVersionToApplicationName}"
                                    Mode="OneWay"
                                    Path="(local:Application.ApplicationVersion)" />
                            </Label.Content>
                        </Label>
                    </DockPanel>

                    <DockPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,5,0">
                        <FlowDocumentScrollViewer
                            Margin="5,10,5,10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Top"
                            Document="{Binding UpgradeVersionDescription.ChangeLog, Source={StaticResource Upgrade}, Converter={StaticResource ChangelogToMarkdown}, ConverterParameter=True|}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto" />

                        <TextBlock
                            Margin="5"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Top"
                            FontSize="14"
                            Visibility="{Binding DisplaySeeChangeLogLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink Command="{Binding GetChangeLogContentCommand, Mode=OneWay}">
                                <Run Text="{x:Static project:Resources.SeeChangeLog}" />
                            </Hyperlink>
                        </TextBlock>
                    </DockPanel>

                    <Image
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="20,20,20,20"
                        VerticalAlignment="Top"
                        Source="{Binding Source=/FileConverter;component/Resources/ApplicationIcon.ico, Converter={StaticResource IcoFileSizeSelector}, ConverterParameter=256}" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="5"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{x:Static project:Resources.DonateDescription}"
                            FontStyle="Italic" />
                        <controls:IconButton
                            Margin="5,0,5,0"
                            Background="#0467B4"
                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                            CommandParameter="https://www.paypal.com/cgi-bin/webscr?cmd=_donations&amp;business=3BDWQTYTTA3D8&amp;item_name=File+Converter+Donations&amp;currency_code=EUR"
                            Content="{x:Static project:Resources.DonateButtonTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            IconSource="/FileConverter;component/Resources/PaypalIcon.png"
                            MouseOverBrush="#007AD8"
                            PressedBrush="#0F4199" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="5,0,5,0"
                            Padding="1"
                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                            CommandParameter="https://github.com/Tichau/FileConverter/?from=about"
                            Style="{DynamicResource TileButton}"
                            ToolTip="{x:Static project:Resources.GitHubButtonDescription}">
                            <Button.Content>
                                <Image Source="/FileConverter;component/Resources/GitHub-Icon.png" />
                            </Button.Content>
                        </Button>
                        <Button
                            Margin="5,0,5,0"
                            Padding="1"
                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                            CommandParameter="https://github.com/Tichau/FileConverter/issues?from=about"
                            Style="{DynamicResource TileButton}"
                            ToolTip="{x:Static project:Resources.IssueButtonDescription}">
                            <Button.Content>
                                <Image Source="/FileConverter;component/Resources/GitHub-Issue-Icon.png" />
                            </Button.Content>
                        </Button>
                        <Button
                            Margin="5,0,5,0"
                            Padding="1"
                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                            CommandParameter="https://github.com/Tichau/FileConverter/wiki?from=about"
                            Style="{DynamicResource TileButton}"
                            ToolTip="{x:Static project:Resources.DocumentationButtonDescription}">
                            <Button.Content>
                                <Image Source="/FileConverter;component/Resources/GitHub-Documentation-Icon.png" />
                            </Button.Content>
                        </Button>
                        <Button
                            Margin="5,0,5,0"
                            Padding="1"
                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                            CommandParameter="https://file-converter.io?from=about"
                            Style="{DynamicResource TileButton}"
                            ToolTip="{x:Static project:Resources.WebsiteButtonDescription}">
                            <Button.Content>
                                <Image Source="/FileConverter;component/Resources/WebSite-Icon.png" />
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,2,0,2"
                        Content="Copyright @ 2026, Adrien Allard. All right reserved."
                        Foreground="{DynamicResource LighterForegroundBrush}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Button
            Grid.Row="2"
            Width="100"
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            Command="{Binding SaveCommand}"
            Content="{x:Static project:Resources.Save}" />

    </Grid>

</Window>
